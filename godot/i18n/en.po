msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: en\n"

#: godot\scripts\actors\owner.gd:309
msgid "Hã...? O que eu tô fazendo aqui...?"
msgstr "Huh...? What am I doing here...?"

#: godot\scripts\actors\owner.gd:309
msgid "Ai... {cat}? Eu tava sonâmbula?"
msgstr "Ugh... {cat}? Was I sleepwalking?"

#: godot\scripts\actors\owner.gd:309
msgid "Ai... {cat}? Eu tava sonâmbulo?"
msgstr "Ugh... {cat}? Was I sleepwalking?"

#: godot\scripts\actors\owner.gd:309
msgid "Que frio... como eu vim parar aqui?"
msgstr "It's freezing... how did I end up here?"

#: godot\scripts\actors\owner.gd:328
msgid "Ô, gato... são três da manhã."
msgstr "Hey, cat... it's three in the morning."

#: godot\scripts\actors\owner.gd:328
msgid "Shh. Dorme, bicho."
msgstr "Shh. Sleep, you."

#: godot\scripts\actors\owner.gd:328
msgid "Cara, de novo?"
msgstr "Seriously, again?"

#: godot\scripts\actors\owner.gd:328
msgid "{cat}... dorme, gato."
msgstr "{cat}... go to sleep, cat."

#: godot\scripts\actors\owner.gd:328
msgid "Hmm... {cat}, são três da manhã..."
msgstr "Hmm... {cat}, it's three in the morning..."

#: godot\scripts\actors\owner.gd:328
msgid "Shhh... {cat}..."
msgstr "Shhh... {cat}..."

#: godot\scripts\actors\owner.gd:330
msgid "{cat}? Você também ouviu?"
msgstr "{cat}? You heard that too?"

#: godot\scripts\actors\owner.gd:330
msgid "Tá aí, {cat}? Fica aqui comigo."
msgstr "You there, {cat}? Stay here with me."

#: godot\scripts\actors\owner.gd:334
msgid "{cat}? O que foi?"
msgstr "{cat}? What is it?"

#: godot\scripts\actors\owner.gd:355
msgid "Tô indo, tô indo."
msgstr "I'm coming, I'm coming."

#: godot\scripts\actors\owner.gd:355
msgid "O que foi agora?"
msgstr "What is it now?"

#: godot\scripts\actors\owner.gd:355
msgid "Já vou, {cat}!"
msgstr "Coming, {cat}!"

#: godot\scripts\actors\owner.gd:355
msgid "Tô indo, {cat}..."
msgstr "I'm coming, {cat}..."

#: godot\scripts\actors\owner.gd:358
msgid "Tá tudo bem aqui... acho."
msgstr "Everything looks fine here... I think."

#: godot\scripts\actors\owner.gd:358
msgid "Nada. Você me enganou, {cat}."
msgstr "Nothing. You tricked me, {cat}."

#: godot\scripts\actors\owner.gd:358
msgid "O que você queria me mostrar?"
msgstr "What did you want to show me?"

#: godot\scripts\actors\owner.gd:382
msgid "O que foi isso?!"
msgstr "What was that?!"

#: godot\scripts\actors\owner.gd:382
msgid "Tem alguém aí?"
msgstr "Is somebody there?"

#: godot\scripts\actors\owner.gd:384
msgid "Hm? ...Gato idiota."
msgstr "Hm? ...Dumb cat."

#: godot\scripts\actors\owner.gd:384
msgid "Que barulho foi esse? Vou ver."
msgstr "What was that noise? I'll go look."

#: godot\scripts\actors\owner.gd:386
msgid "{cat}! O que você derrubou?"
msgstr "{cat}! What did you knock over?"

#: godot\scripts\actors\owner.gd:386
msgid "Sério, {cat}?"
msgstr "Seriously, {cat}?"

#: godot\scripts\actors\owner.gd:386
msgid "Mas que barulho é esse..."
msgstr "What is that noise..."

#: godot\scripts\actors\owner.gd:393
msgid "Ninguém. Só o gato aprontando."
msgstr "Nobody. Just the cat up to no good."

#: godot\scripts\actors\owner.gd:393
msgid "Nada aqui... estranho."
msgstr "Nothing here... weird."

#: godot\scripts\actors\owner.gd:400
msgid "{cat}!! Era meu copo!"
msgstr "{cat}!! That was my glass!"

#: godot\scripts\actors\owner.gd:400
msgid "Ah não... {cat}!"
msgstr "Oh no... {cat}!"

#: godot\scripts\actors\owner.gd:718
msgid "Gato? ...Isso aí não tá certo."
msgstr "Cat? ...Something's not right here."

#: godot\scripts\actors\owner.gd:718
msgid "Tem alguma coisa aqui, não tem?"
msgstr "There's something here, isn't there?"

#: godot\scripts\actors\owner.gd:718
msgid "Ô, {cat}... vem pra cá."
msgstr "Hey, {cat}... come here."

#: godot\scripts\actors\owner.gd:720
msgid "{cat}? Cadê você?"
msgstr "{cat}? Where are you?"

#: godot\scripts\actors\owner.gd:720
msgid "{cat}... vem cá..."
msgstr "{cat}... come here..."

#: godot\scripts\actors\owner.gd:720
msgid "{cat}? Você tá vendo isso?"
msgstr "{cat}? Do you see that?"

#: godot\scripts\actors\owner.gd:727
msgid "Por favor... por favor..."
msgstr "Please... please..."

#: godot\scripts\actors\owner.gd:727
msgid "Vai embora... vai embora..."
msgstr "Go away... go away..."

#: godot\scripts\actors\owner.gd:727
msgid "{cat}... me ajuda..."
msgstr "{cat}... help me..."

#: godot\scripts\actors\owner.gd:727
msgid "Isso não é real..."
msgstr "This isn't real..."

#: godot\scripts\autoload\controls.gd:49
msgid "Espaço"
msgstr "Space"

#: godot\scripts\game\game.gd:1009
msgid "Noite %d · %s"
msgstr "Night %d · %s"

#: godot\scripts\game\game.gd:1038
msgid "{cat}! Fora do meu quarto. Banheiro, já."
msgstr "{cat}! Out of my room. Bathroom, now."

#: godot\scripts\game\game.gd:1038
msgid "{cat}! CHEGA! Banheiro, agora."
msgstr "{cat}! ENOUGH! Bathroom, now."

#: godot\scripts\game\game.gd:1056
msgid "Você foi trancado no banheiro por uma hora. Arranhe a porta (segure %s)%s"
msgstr "You were locked in the bathroom for an hour. Scratch the door (hold %s)%s"

#: godot\scripts\game\game.gd:1056
msgid " ou fuja pela janela basculante."
msgstr " or escape through the tilt window."

#: godot\scripts\game\game.gd:1056
msgid ". Da próxima vez, abra a basculante de manhã."
msgstr ". Next time, open the tilt window in the morning."

#: godot\scripts\game\game.gd:106
msgid "Pintando as paredes"
msgstr "Painting the walls"

#: godot\scripts\game\game.gd:1066
msgid "Tá... pode sair. Mas fica quieto, {cat}."
msgstr "Fine... you can come out. But stay quiet, {cat}."

#: godot\scripts\game\game.gd:1073
msgid "{cat}!! Para de arranhar essa porta!"
msgstr "{cat}!! Quit scratching that door!"

#: godot\scripts\game\game.gd:1100
msgid "O círculo está completo. Quando a Coisa acordar, termine o ritual."
msgstr "The circle is complete. When the Thing wakes, finish the ritual."

#: godot\scripts\game\game.gd:1123
msgid "Quando os tentáculos se erguerem, [b]bufe[/b] (%s) para cancelar a onda."
msgstr "When the tentacles rise, [b]hiss[/b] (%s) to cancel the wave."

#: godot\scripts\game\game.gd:1144
msgid "No corredor, de madrugada, não tinha nada."
msgstr "In the hallway, in the small hours, there was nothing."

#: godot\scripts\game\game.gd:1145
msgid "Ela, sentada no escuro da sala, às três da manhã."
msgstr "Her, sitting in the dark of the living room at three in the morning."

#: godot\scripts\game\game.gd:1146
msgid "A TV ligada, falando sozinha a noite inteira."
msgstr "The TV on, talking to itself all night long."

#: godot\scripts\game\game.gd:1147
msgid "A torneira que ela esqueceu aberta."
msgstr "The faucet she left running."

#: godot\scripts\game\game.gd:1148
msgid "E a porta do banheiro, trancada por dentro, por tempo demais."
msgstr "And the bathroom door, locked from the inside for far too long."

#: godot\scripts\game\game.gd:115
msgid "Construindo a casa"
msgstr "Building the house"

#: godot\scripts\game\game.gd:122
msgid "Acordando o gato"
msgstr "Waking the cat"

#: godot\scripts\game\game.gd:1297
msgid "Dia %d"
msgstr "Day %d"

#: godot\scripts\game\game.gd:1297
msgid "Manhã · a casa está vazia"
msgstr "Morning · the house is empty"

#: godot\scripts\game\game.gd:1302
msgid "De manhã a casa é segura. Prepare-se para a noite: as tarefas ficam no canto da tela."
msgstr "The house is safe in the morning. Get ready for the night: the tasks are in the corner of the screen."

#: godot\scripts\game\game.gd:1305
msgid "Procure de perto as [b]marcas[/b] que as assombrações deixaram."
msgstr "Look closely for the [b]marks[/b] the haunts left behind."

#: godot\scripts\game\game.gd:134
msgid "Abrindo as janelas"
msgstr "Opening the windows"

#: godot\scripts\game\game.gd:1346
msgid "Preparo da manhã"
msgstr "Morning prep"

#: godot\scripts\game\game.gd:1346
msgid "Clara volta em %d:%02d · ou durma na caminha"
msgstr "Clara is back in %d:%02d · or sleep in the cat bed"

#: godot\scripts\game\game.gd:1354
msgid "uma foto antiga"
msgstr "an old photo"

#: godot\scripts\game\game.gd:1354
msgid "uma coleira antiga"
msgstr "an old collar"

#: godot\scripts\game\game.gd:1354
msgid "uma chave pequena"
msgstr "a small key"

#: godot\scripts\game\game.gd:1356
msgid "Dona Ivone, com um gato preto no colo. Atrás: “Sete anos juntos”."
msgstr "Mrs. Ivone, with a black cat in her lap. Behind them: “Seven years together”."

#: godot\scripts\game\game.gd:1357
msgid "Uma coleira vermelha com um sininho. No pingente: “Breu”."
msgstr "A red collar with a little bell. On the tag: “Breu”."

#: godot\scripts\game\game.gd:1358
msgid "Uma chave pequena e enferrujada. Abre o baú do sótão."
msgstr "A small, rusty key. It opens the chest in the attic."

#: godot\scripts\game\game.gd:1360
msgid "Você encontrou %s. %s"
msgstr "You found %s. %s"

#: godot\scripts\game\game.gd:1387
msgid "%s cochilou no sol da janela..."
msgstr "%s dozed off in the window sun..."

#: godot\scripts\game\game.gd:145
msgid "Chamando as assombrações"
msgstr "Calling the haunts"

#: godot\scripts\game\game.gd:152
msgid "a chave do cadeado"
msgstr "the padlock key"

#: godot\scripts\game\game.gd:158
msgid "As lâmpadas queimam sozinhas depois de 10–20 s. Pule no interruptor de novo para religar."
msgstr "The bulbs burn out on their own after 10–20 s. Jump on the switch again to turn them back on."

#: godot\scripts\game\game.gd:163
msgid "Acendendo a casa"
msgstr "Turning on the lights"

#: godot\scripts\game\game.gd:1638
msgid "Fim de tarde · a mudança"
msgstr "Late afternoon · the move"

#: godot\scripts\game\game.gd:1638
msgid "Fim de tarde · Davi está chegando"
msgstr "Late afternoon · Davi is on his way"

#: godot\scripts\game\game.gd:1639
msgid "Fim de tarde · Clara chegou"
msgstr "Late afternoon · Clara is home"

#: godot\scripts\game\game.gd:1643
msgid "O [b]losango[/b] dourado mostra aonde ir. As tarefas ficam no canto da tela."
msgstr "The golden [b]diamond[/b] shows where to go. The tasks are in the corner of the screen."

#: godot\scripts\game\game.gd:1645
msgid "Ganhe a [b]Paciência[/b] de Clara para a noite: peça carinho, coma, brinque com o ratinho."
msgstr "Earn Clara's [b]Patience[/b] for the night: ask for pets, eat, play with the toy mouse."

#: godot\scripts\game\game.gd:168
msgid "Apagando as luzes"
msgstr "Turning off the lights"

#: godot\scripts\game\game.gd:1723
msgid "Clara quer que você coma com ela. Vá até a [b]tigela[/b] na cozinha e segure %s."
msgstr "Clara wants you to eat with her. Go to the [b]bowl[/b] in the kitchen and hold %s."

#: godot\scripts\game\game.gd:1757
msgid "...Mais um \"não\" educado. Tá. Próximo."
msgstr "...Another polite \"no.\" Okay. Next."

#: godot\scripts\game\game.gd:1759
msgid "Casamento na novela? Hoje não. Próximo canal."
msgstr "A wedding on the soap? Not today. Next channel."

#: godot\scripts\game\game.gd:1761
msgid "Vem, {cat}! Vem cá no colo."
msgstr "Come on, {cat}! Come sit on my lap."

#: godot\scripts\game\game.gd:1764
msgid "Pule no colo de Clara: o [b]círculo[/b] aparece quando você olha para ela."
msgstr "Jump onto Clara's lap: the [b]circle[/b] shows up when you look at her."

#: godot\scripts\game\game.gd:1777
msgid "Pronto. Sem TV hoje."
msgstr "There. No TV today."

#: godot\scripts\game\game.gd:1789
msgid "Alô? ...Ah. É você."
msgstr "Hello? ...Oh. It's you."

#: godot\scripts\game\game.gd:1791
msgid "Não, Rafael. Eu tô bem. Tô ótima."
msgstr "No, Rafael. I'm fine. I'm great."

#: godot\scripts\game\game.gd:1793
msgid "Não. Não vem. E para de bater na porta dos outros às duas da manhã. Três batidinhas. Eu conheço."
msgstr "No. Don't come. And stop knocking on other people's doors at two in the morning. Three little knocks. I know them."

#: godot\scripts\game\game.gd:1795
msgid "Tchau, Rafael."
msgstr "Bye, Rafael."

#: godot\scripts\game\game.gd:1798
msgid "...Tá tudo certo, {cat}. Tá tudo certo."
msgstr "...It's all fine, {cat}. It's all fine."

#: godot\scripts\game\game.gd:1807
msgid "Um diário? ...Faltam páginas. Alguém arrancou."
msgstr "A diary? ...Pages are missing. Someone tore them out."

#: godot\scripts\game\game.gd:1821
msgid "Quarenta anos sozinha aqui. Ninguém veio ver ela."
msgstr "Forty years alone here. Nobody came to check on her."

#: godot\scripts\game\game.gd:1824
msgid "...É. Vou dormir cedo hoje."
msgstr "...Yeah. I'm going to bed early tonight."

#: godot\scripts\game\game.gd:1834
msgid "Hoje a gente dorme de luz acesa, Davi."
msgstr "Tonight we sleep with the light on, Davi."

#: godot\scripts\game\game.gd:1838
msgid "Você ouviu isso?"
msgstr "Did you hear that?"

#: godot\scripts\game\game.gd:1841
msgid "Davi... eu tô cansada. Muito."
msgstr "Davi... I'm tired. So tired."

#: godot\scripts\game\game.gd:1844
msgid "Seja o que for... a gente passa por essa noite."
msgstr "Whatever it is... we'll get through this night."

#: godot\scripts\game\game.gd:1846
msgid "{cat}, fica de olho. Por favor."
msgstr "{cat}, keep an eye out. Please."

#: godot\scripts\game\game.gd:1868
msgid "Pegue a [b]chave[/b] em cima da caixa da mudança, na sala, e leve para Clara no porão."
msgstr "Grab the [b]key[/b] from the moving box in the living room and take it to Clara in the basement."

#: godot\scripts\game\game.gd:1981
msgid "Vem, {cat}. Hora de dormir."
msgstr "Come on, {cat}. Bedtime."

#: godot\scripts\game\game.gd:2008
msgid "Pronto. Tudo trancado."
msgstr "There. All locked up."

#: godot\scripts\game\game.gd:2011
msgid "Hoje essa luz fica acesa."
msgstr "That light stays on tonight."

#: godot\scripts\game\game.gd:204
msgid "Seu miado tirou %s do transe. Mas o problema continua lá."
msgstr "Your meow snapped %s out of the trance. But the problem is still there."

#: godot\scripts\game\game.gd:206
msgid "Miar chama as pessoas até você. Use isso para tirá-las de perigo, mas elas andam pela casa escura."
msgstr "Meowing calls people to you. Use it to pull them out of danger, but they walk through the dark house."

#: godot\scripts\game\game.gd:210
msgid "Pouco [b]Foco[/b]: o bufo saiu fraco. Espere o Foco recarregar."
msgstr "Low on [b]Focus[/b]: the hiss came out weak. Wait for Focus to recharge."

#: godot\scripts\game\game.gd:2105
msgid "Ai! Que susto!"
msgstr "Ah! You scared me!"

#: godot\scripts\game\game.gd:2129
msgid "Isso! Que gato bom."
msgstr "That's it! Good cat."

#: godot\scripts\game\game.gd:2130
msgid "No colo o [b]Foco[/b] recarrega como ronronando. Mexa-se para descer."
msgstr "In her lap, [b]Focus[/b] recharges like purring. Move to get down."

#: godot\scripts\game\game.gd:2152
msgid "Vou tomar um banho quentinho..."
msgstr "I'm going to take a nice hot bath..."

#: godot\scripts\game\game.gd:2175
msgid "Clara se trancou no banho. Arranhe a porta do banheiro."
msgstr "Clara locked herself in to bathe. Scratch the bathroom door."

#: godot\scripts\game\game.gd:2247
msgid "{cat}, sai! Um minutinho de privacidade, por favor."
msgstr "{cat}, out! A minute of privacy, please."

#: godot\scripts\game\game.gd:2266
msgid "Tá aberta, {cat}. Pode entrar, chato."
msgstr "It's open, {cat}. Come in, you pest."

#: godot\scripts\game\game.gd:2266
msgid "{cat}? Pode entrar, tá aberta."
msgstr "{cat}? Come in, it's open."

#: godot\scripts\game\game.gd:2270
msgid "Algo se mexe na água. Tire Clara da banheira."
msgstr "Something is moving in the water. Get Clara out of the tub."

#: godot\scripts\game\game.gd:2290
msgid "Tá bom, tá bom! Já saí, chato."
msgstr "Okay, okay! I'm out, you pest."

#: godot\scripts\game\game.gd:2294
msgid "Brr... que água gelada de repente."
msgstr "Brr... why is the water suddenly so cold."

#: godot\scripts\game\game.gd:2312
msgid "É ele!"
msgstr "It's him!"

#: godot\scripts\game\game.gd:2327
msgid "O quarto de hóspedes é lá em cima, o da direita."
msgstr "The guest room is upstairs, the one on the right."

#: godot\scripts\game\game.gd:2334
msgid "Guarda isso, Davi."
msgstr "Put that away, Davi."

#: godot\scripts\game\game.gd:2336
msgid "...Eu já tinha escolhido o nome, sabia? Deixa pra lá."
msgstr "...I'd already picked the name, you know? Never mind."

#: godot\scripts\game\game.gd:2338
msgid "Obrigada por vir. A mãe que pediu, né?"
msgstr "Thanks for coming. Mom asked you to, right?"

#: godot\scripts\game\game.gd:2342
msgid "Se ouvir barulho de noite, é a casa velha. Né?"
msgstr "If you hear noises at night, it's just the old house. Right?"

#: godot\scripts\game\game.gd:2371
msgid "Então é aqui a casa barata? Gostei, mana."
msgstr "So this is the cheap house? I like it, sis."

#: godot\scripts\game\game.gd:2374
msgid "{cat}! Saudade, seu peludo. Ainda sou alérgico, mas tudo bem."
msgstr "{cat}! I missed you, fluffball. I'm still allergic, but whatever."

#: godot\scripts\game\game.gd:2402
msgid "Quarto de hóspedes... cheio de caixa. Perfeito."
msgstr "Guest room... full of boxes. Perfect."

#: godot\scripts\game\game.gd:2406
msgid "Ué... esse baú não é nosso."
msgstr "Huh... this chest isn't ours."

#: godot\scripts\game\game.gd:2417
msgid "Olha o que tinha aqui!"
msgstr "Look what was in here!"

#: godot\scripts\game\game.gd:2438
msgid "Que mãe? Eu vim porque quis. ...E porque ela pediu."
msgstr "What mom? I came because I wanted to. ...And because she asked."

#: godot\scripts\game\game.gd:2476
msgid "Cheguei! Trouxe pão de queijo. Quem tava no telefone?"
msgstr "I'm here! Brought cheese bread. Who was on the phone?"

#: godot\scripts\game\game.gd:2476
msgid "Mana, olha isso. Tava no fundo daquele baú. É o diário da antiga dona."
msgstr "Sis, look at this. It was at the bottom of that chest. It's the old owner's diary."

#: godot\scripts\game\game.gd:2476
msgid "Cheguei. Último dia dessa semana maluca."
msgstr "I'm here. Last day of this crazy week."

#: godot\scripts\game\game.gd:2523
msgid "Cano velho."
msgstr "Old pipe."

#: godot\scripts\game\game.gd:2527
msgid "Eu sei, mana. Eu tô aqui."
msgstr "I know, sis. I'm here."

#: godot\scripts\game\game.gd:2533
msgid "Por isso eu vim, sabia?"
msgstr "That's why I came, you know?"

#: godot\scripts\game\game.gd:2642
msgid "Oi, {cat}! Tá me seguindo, é?"
msgstr "Hi, {cat}! Following me, huh?"

#: godot\scripts\game\game.gd:2642
msgid "Que foi, {cat}? Quer atenção?"
msgstr "What is it, {cat}? Want attention?"

#: godot\scripts\game\game.gd:2642
msgid "Você é o melhor gato do mundo, sabia?"
msgstr "You're the best cat in the world, you know that?"

#: godot\scripts\game\game.gd:2642
msgid "Ei, coisinha. Tô aqui."
msgstr "Hey, little one. I'm here."

#: godot\scripts\game\game.gd:2663
msgid "Clara foi deitar. Suba na cama e [b]deite com ela[/b] (%s): a noite começa quando você ronronar com ela."
msgstr "Clara went to bed. Climb onto the bed and [b]lie down with her[/b] (%s): the night begins when you purr with her."

#: godot\scripts\game\game.gd:2669
msgid "...{cat}, sai daqui. Por favor."
msgstr "...{cat}, get out of here. Please."

#: godot\scripts\game\game.gd:2678
msgid "Quem é o gato mais lindo dessa casa?"
msgstr "Who's the prettiest cat in this house?"

#: godot\scripts\game\game.gd:2678
msgid "Ownn, vem cá, {cat}."
msgstr "Awww, come here, {cat}."

#: godot\scripts\game\game.gd:2678
msgid "Que carente você tá hoje!"
msgstr "Aren't you clingy today!"

#: godot\scripts\game\game.gd:2700
msgid "Pega! Pega o ratinho! Hahaha."
msgstr "Get it! Get the mousie! Hahaha."

#: godot\scripts\game\game.gd:2789
msgid "Já tá com sono, {cat}? Então vamos dormir."
msgstr "Sleepy already, {cat}? Then let's sleep."

#: godot\scripts\game\game.gd:2824
msgid "Ah! {cat}... eu não conseguia me mexer..."
msgstr "Ah! {cat}... I couldn't move..."

#: godot\scripts\game\game.gd:2837
msgid "Boa noite, {cat}..."
msgstr "Good night, {cat}..."

#: godot\scripts\game\game.gd:2841
msgid "Ronronar acalma %s, mas você não está patrulhando. %s para levantar."
msgstr "Purring calms %s, but you aren't on patrol. %s to get up."

#: godot\scripts\game\game.gd:2885
msgid "Hmm... apaga isso, {cat}..."
msgstr "Hmm... turn that off, {cat}..."

#: godot\scripts\game\game.gd:3051
msgid "Limpa. Agora pode ir para o círculo."
msgstr "Clean. Now it can go to the circle."

#: godot\scripts\game\game.gd:3148
msgid "A foto"
msgstr "The photo"

#: godot\scripts\game\game.gd:3148
msgid "A coleira"
msgstr "The collar"

#: godot\scripts\game\game.gd:3148
msgid "A chave"
msgstr "The key"

#: godot\scripts\game\game.gd:3150
msgid "O ritual"
msgstr "The ritual"

#: godot\scripts\game\game.gd:3150
msgid "Leve tudo ao círculo do porão e complete o ritual quando a Coisa acordar."
msgstr "Take everything to the basement circle and finish the ritual when the Thing wakes."

#: godot\scripts\game\game.gd:3166
msgid " (%s)"
msgstr " (%s)"

#: godot\scripts\game\game.gd:3169
msgid "Objetos de Dona Ivone · %d/%d"
msgstr "Mrs. Ivone's things · %d/%d"

#: godot\scripts\game\game.gd:3169
msgid "Leve cada um ao círculo do porão. A noite só acaba quando todos estiverem lá."
msgstr "Take each one to the basement circle. The night only ends when all of them are there."

#: godot\scripts\game\game.gd:3180
msgid "A Sombra está escondida %s: acenda a luz"
msgstr "The Shadow is hiding %s: turn on the light"

#: godot\scripts\game\game.gd:3192
msgid "Arranhe a porta do banheiro"
msgstr "Scratch the bathroom door"

#: godot\scripts\game\game.gd:3194
msgid " · ela desistiu"
msgstr " · she gave up"

#: godot\scripts\game\game.gd:3200
msgid " (%d/3)"
msgstr " (%d/3)"

#: godot\scripts\game\game.gd:3203
msgid "Deite com a Clara na cama"
msgstr "Lie down with Clara in bed"

#: godot\scripts\game\game.gd:3203
msgid "Quando ela for dormir, deite com ela"
msgstr "When she goes to sleep, lie down with her"

#: godot\scripts\game\game.gd:3204
msgid "Fim de tarde · dia %d"
msgstr "Late afternoon · day %d"

#: godot\scripts\game\game.gd:3204
msgid "A tarde só acaba quando você deitar com ela. Paciência de Clara: %d%%"
msgstr "The afternoon only ends when you lie down with her. Clara's Patience: %d%%"

#: godot\scripts\game\game.gd:3239
msgid "Coma a ração"
msgstr "Eat the kibble"

#: godot\scripts\game\game.gd:3326
msgid "Está coberta de lama. Lave na pia do banheiro antes de deixar no círculo."
msgstr "It's covered in mud. Wash it in the bathroom sink before leaving it in the circle."

#: godot\scripts\game\game.gd:3338
msgid "O círculo recusou. O diário dizia a ordem: %s."
msgstr "The circle refused. The diary gave the order: %s."

#: godot\scripts\game\game.gd:345
msgid "Ouça. As [b]orelhas[/b] do %s apontam para o perigo."
msgstr "Listen. %s's [b]ears[/b] point toward danger."

#: godot\scripts\game\game.gd:346
msgid "Pule nos interruptores com %s. Acenda a luz do cômodo onde a Sombra está."
msgstr "Jump on the switches with %s. Turn on the light in the room where the Shadow is."

#: godot\scripts\game\game.gd:3474
msgid "a caixa"
msgstr "the box"

#: godot\scripts\game\game.gd:3479
msgid "A caixa engoliu quem caçava você, mas ficou estragada. Não serve mais."
msgstr "The box swallowed whatever was hunting you, but it's ruined. It's no good anymore."

#: godot\scripts\game\game.gd:3514
msgid "Parado e escondido, o cão não acha você. Ele fareja por perto e vai embora. Interagir para sair."
msgstr "Still and hidden, the hound can't find you. He sniffs around and leaves. Interact to come out."

#: godot\scripts\game\game.gd:3553
msgid "Que grito foi esse?!"
msgstr "What was that scream?!"

#: godot\scripts\game\game.gd:3553
msgid "{cat}?! O que foi isso?!"
msgstr "{cat}?! What was that?!"

#: godot\scripts\game\game.gd:3566
msgid "Última vida"
msgstr "Last life"

#: godot\scripts\game\game.gd:3568
msgid "O cão te pegou e levou uma das suas sete vidas. Esconda-se, suba em móveis ou fuja pelo duto da próxima vez."
msgstr "The hound got you and took one of your seven lives. Next time, hide, climb on furniture, or escape through the vent."

#: godot\scripts\game\game.gd:3570
msgid "Você perdeu uma das sete vidas. As vidas valem para a semana inteira; dá para rejogar uma noite no menu e recuperá-las."
msgstr "You lost one of your seven lives. Lives last the whole week; you can replay a night from the menu to get them back."

#: godot\scripts\game\game.gd:3585
msgid "[b]%s[/b] vem atrás de você! %s"
msgstr "[b]%s[/b] is coming for you! %s"

#: godot\scripts\game\game.gd:3611
msgid "a casa"
msgstr "the house"

#: godot\scripts\game\game.gd:3614
msgid "As sete vidas acabaram"
msgstr "All seven lives are gone"

#: godot\scripts\game\game.gd:3615
msgid "A última vida foi levada por %s."
msgstr "The last life was taken by %s."

#: godot\scripts\game\game.gd:3616
msgid "Rejogue uma noite anterior no menu (Escolher noite) perdendo menos vidas: elas voltam para as noites seguintes."
msgstr "Replay an earlier night from the menu (Choose night) losing fewer lives: they carry over to the following nights."

#: godot\scripts\game\game.gd:3617
msgid "Esta noite começa com %d %s"
msgstr "This night starts with %d %s"

#: godot\scripts\game\game.gd:3634
msgid "Dia %d · %s"
msgstr "Day %d · %s"

#: godot\scripts\game\game.gd:3634
msgid "manhã"
msgstr "morning"

#: godot\scripts\game\game.gd:3634
msgid "fim de tarde"
msgstr "late afternoon"

#: godot\scripts\game\game.gd:3749
msgid "O gato está cansado: menos Foco e mais lento. Ronronar na cama recupera o sono."
msgstr "The cat is tired: less Focus and slower. Purring in bed restores sleep."

#: godot\scripts\game\game.gd:376
msgid "Ela vai voltar. Leve os objetos de Ivone ao porão para a noite acabar."
msgstr "She'll be back. Take Ivone's things to the basement to end the night."

#: godot\scripts\game\game.gd:3830
msgid "Sair do esconderijo"
msgstr "Leave the hiding spot"

#: godot\scripts\game\game.gd:3876
msgid "Soltar %s"
msgstr "Drop %s"

#: godot\scripts\game\game.gd:3982
msgid "Manhã"
msgstr "Morning"

#: godot\scripts\game\game.gd:3984
msgid "Fim de tarde"
msgstr "Late afternoon"

#: godot\scripts\game\game.gd:4013
msgid "%s → %s"
msgstr "%s → %s"

#: godot\scripts\game\game.gd:537
msgid "Noite %d"
msgstr "Night %d"

#: godot\scripts\game\game.gd:537
msgid "Dia %d · manhã"
msgstr "Day %d · morning"

#: godot\scripts\game\game.gd:785
msgid "Proteja a Clara. Enquanto ela dorme, os fantasmas vêm atrás dela. Só você consegue vê-los."
msgstr "Protect Clara. While she sleeps, the ghosts come for her. Only you can see them."

#: godot\scripts\game\game.gd:785
msgid "Proteja a Clara dos fantasmas esta noite."
msgstr "Protect Clara from the ghosts tonight."

#: godot\scripts\game\game.gd:787
msgid "Esta noite só termina quando você levar [b]%d objetos de Dona Ivone[/b] ao círculo do porão. Chegue perto e eles se destacam no escuro. A lista no canto mostra quantos faltam."
msgstr "Tonight only ends when you take [b]%d of Mrs. Ivone's things[/b] to the basement circle. Get close and they stand out in the dark. The list in the corner shows how many are left."

#: godot\scripts\game\game.gd:789
msgid "Primeira noite na casa nova, {cat}. Boa noite..."
msgstr "First night in the new house, {cat}. Good night..."

#: godot\scripts\game\game.gd:790
msgid "Mova-se com %s e olhe com o mouse. %s corre."
msgstr "Move with %s and look with the mouse. %s runs."

#: godot\scripts\game\game.gd:791
msgid "Quando aparecer um [b]círculo[/b] no chão ou num móvel, %s pula até ele."
msgstr "When a [b]circle[/b] appears on the floor or on furniture, %s jumps to it."

#: godot\scripts\game\game.gd:793
msgid "%s mia e [b]chama[/b] as pessoas até você. Também tira alguém de um transe, mas irrita quem dorme."
msgstr "%s meows and [b]calls[/b] people to you. It also pulls someone out of a trance, but annoys whoever is sleeping."

#: godot\scripts\game\game.gd:794
msgid "Derrubar coisas faz barulho: quem caça pelo som vai até lá. Use isso como isca."
msgstr "Knocking things over makes noise: whatever hunts by sound goes there. Use it as a decoy."

#: godot\scripts\game\game.gd:796
msgid "%s bufa: espanta ou enfraquece o que estiver por perto. O botão aparece na tela quando adianta. Gasta Foco."
msgstr "%s hisses: scares off or weakens whatever is nearby. The button shows up on screen when it would help. Costs Focus."

#: godot\scripts\game\game.gd:798
msgid "Segure %s para ver a hora. Mas a hora não salva ninguém: a noite só acaba com os objetos de Ivone no círculo."
msgstr "Hold %s to check the time. But the time saves no one: the night only ends with Ivone's things in the circle."

#: godot\scripts\game\game.gd:799
msgid "Agora são [b]dois[/b] para proteger. Cada ameaça escolhe um alvo."
msgstr "Now there are [b]two[/b] to protect. Each threat picks a target."

#: godot\scripts\game\game.gd:832
msgid "Chega por hoje. Boa noite, casa velha."
msgstr "That's enough for today. Good night, old house."

#: godot\scripts\game\game.gd:892
msgid "Quando alguém tem medo, a casa perde a cor. Ouça o coração."
msgstr "When someone is afraid, the house loses its color. Listen to the heartbeat."

#: godot\scripts\game\game.gd:894
msgid "Deite com %s na cama (%s) e ronrone para acalmar."
msgstr "Lie down with %s in bed (%s) and purr to calm them."

#: godot\scripts\game\game.gd:896
msgid "%s está perdendo a paciência. Se ficar irritado(a), vai te trancar no banheiro."
msgstr "%s is losing patience. If they get annoyed, they'll lock you in the bathroom."

#: godot\scripts\game\game.gd:904
msgid "Que sede..."
msgstr "So thirsty..."

#: godot\scripts\game\game.gd:913
msgid "Hmm... banheiro..."
msgstr "Hmm... bathroom..."

#: godot\scripts\game\game.gd:936
msgid "Bom dia, {cat}... que noite estranha."
msgstr "Morning, {cat}... what a strange night."

#: godot\scripts\game\game.gd:946
msgid "Noite %d sobrevivida"
msgstr "Night %d survived"

#: godot\scripts\game\game.gd:947
msgid "Clara e Davi sobreviveram"
msgstr "Clara and Davi survived"

#: godot\scripts\game\game.gd:947
msgid "Clara sobreviveu"
msgstr "Clara survived"

#: godot\scripts\game\game.gd:948
msgid "Assombrações afastadas"
msgstr "Haunts driven off"

#: godot\scripts\game\game.gd:948
msgid "Medo máximo"
msgstr "Peak fear"

#: godot\scripts\game\game.gd:948
msgid "Vezes trancado no banheiro"
msgstr "Times locked in the bathroom"

#: godot\scripts\game\game.gd:948
msgid "Vezes pego pelo cão"
msgstr "Times caught by the hound"

#: godot\scripts\game\game.gd:948
msgid "Vidas perdidas"
msgstr "Lives lost"

#: godot\scripts\game\game.gd:948
msgid "%d (restam %d)"
msgstr "%d (%d left)"

#: godot\scripts\game\game.gd:974
msgid "%s não aguentou o medo"
msgstr "%s couldn't take the fear"

#: godot\scripts\game\game.gd:974
msgid "O medo foi se acumulando sem parar, até não restar coragem."
msgstr "Fear kept building without letting up, until no courage was left."

#: godot\scripts\game\game.gd:974
msgid "Ronronar na cama acalma. Resolva as ameaças cedo, antes de o medo disparar."
msgstr "Purring in bed calms. Deal with threats early, before fear spikes."

#: godot\scripts\game\game.gd:976
