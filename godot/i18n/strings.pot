msgid "Animações"
msgstr ""

#: godot\scripts\game\story.gd:281
msgid "Quaternius, Universal Animation Library (CC0)"
msgstr ""

#: godot\scripts\game\story.gd:282
msgid "Obrigado por jogar."
msgstr ""

#: godot\scripts\game\story.gd:29
msgid "A Coisa no Porão"
msgstr ""

#: godot\scripts\game\story.gd:29
msgid "Ela acordou. Não ataca, mas a casa fica mais difícil: termine o ritual."
msgstr ""

#: godot\scripts\game\story.gd:30
msgid "Leve a foto, a coleira, a chave e as coisas de Ivone ao círculo, depois segure sobre ele para completar o ritual. A Coisa não ataca: só deixa a casa mais difícil."
msgstr ""

#: godot\scripts\game\story.gd:36
msgid "Investigue as marcas"
msgstr ""

#: godot\scripts\game\story.gd:37
msgid "Abra a grade do duto na lavanderia"
msgstr ""

#: godot\scripts\game\story.gd:40
msgid "Investigue as torneiras"
msgstr ""

#: godot\scripts\game\story.gd:41
msgid "Empurre a caixa de papelão até um bom lugar (refúgio de uma vez só)"
msgstr ""

#: godot\scripts\game\story.gd:44
msgid "Investigue o baú do sótão"
msgstr ""

#: godot\scripts\game\story.gd:45
msgid "Abra a janela basculante do banheiro de cima"
msgstr ""

#: godot\scripts\game\story.gd:48
msgid "Investigue a porta da frente"
msgstr ""

#: godot\scripts\game\story.gd:49
msgid "Empurre a portinhola da despensa para o quintal"
msgstr ""

#: godot\scripts\game\story.gd:52
msgid "Leve a luz noturna para um cômodo escuro"
msgstr ""

#: godot\scripts\game\story.gd:53
msgid "Empurre a segunda caixa de papelão até um bom lugar"
msgstr ""

#: godot\scripts\game\story.gd:56
msgid "Puxe o cordão do sótão, no corredor"
msgstr ""

#: godot\scripts\game\story.gd:57
msgid "Abra a janela do porão"
msgstr ""

#: godot\scripts\game\story.gd:64
msgid "uma página do diário"
msgstr ""

#: godot\scripts\game\story.gd:64
msgid "“Breu chegou numa noite de chuva. Miou na porta até eu abrir. Ficou.”"
msgstr ""

#: godot\scripts\game\story.gd:65
msgid "“Ele dorme virado para a porta do porão. Quando apago a luz, ele rosna para o escuro.”"
msgstr ""

#: godot\scripts\game\story.gd:66
msgid "“Hoje vi uma mancha no canto do corredor. Ela se mexeu quando acendi a luz.”"
msgstr ""

#: godot\scripts\game\story.gd:69
msgid "uma fita cassete"
msgstr ""

#: godot\scripts\game\story.gd:69
msgid "Na fita, a voz de Ivone: “Se alguém ouvir isto... não deixe o rádio ligado à noite.”"
msgstr ""

#: godot\scripts\game\story.gd:7
msgid "Clara comprou a casa barata.\nDisse que era um recomeço."
msgstr ""

#: godot\scripts\game\story.gd:70
msgid "Chiado. Depois, uma voz que imita a de Ivone, devagar demais: “...vem aqui...”"
msgstr ""

#: godot\scripts\game\story.gd:71
msgid "Ivone, cansada: “Breu puxa os fios com a boca. Acho que ele sabe de alguma coisa.”"
msgstr ""

#: godot\scripts\game\story.gd:74
msgid "o anel de Ivone"
msgstr ""

#: godot\scripts\game\story.gd:74
msgid "O anel de casamento. Ela o tirava para lavar a louça e o deixava ao lado da pia."
msgstr ""

#: godot\scripts\game\story.gd:75
msgid "um grampo de cabelo"
msgstr ""

#: godot\scripts\game\story.gd:75
msgid "Um grampo com uma florzinha. Ainda úmido, como se tivesse saído da água agora."
msgstr ""

#: godot\scripts\game\story.gd:76
msgid "Outro grampo, preso num fio de cabelo branco e comprido."
msgstr ""

#: godot\scripts\game\story.gd:79
msgid "um vestidinho da boneca"
msgstr ""

#: godot\scripts\game\story.gd:79
msgid "Costurado à mão. Na barra, bordado: “Para a minha menina, que nunca veio.”"
msgstr ""

#: godot\scripts\game\story.gd:8
msgid "Ela diz que está tudo bem.\nEla diz isso para todo mundo."
msgstr ""

#: godot\scripts\game\story.gd:80
msgid "uma touca de renda"
msgstr ""

#: godot\scripts\game\story.gd:80
msgid "Uma touca minúscula. Cheira a naftalina e a baú fechado."
msgstr ""

#: godot\scripts\game\story.gd:81
msgid "um sapatinho"
msgstr ""

#: godot\scripts\game\story.gd:81
msgid "Um sapatinho de pano. A sola está gasta, como se alguém tivesse andado muito com ele."
msgstr ""

#: godot\scripts\game\story.gd:82
msgid "um laço de fita"
msgstr ""

#: godot\scripts\game\story.gd:82
msgid "Um laço vermelho. Ivone escreveu no diário que a boneca não gostava de ficar sem ele."
msgstr ""

#: godot\scripts\game\story.gd:85
msgid "uma carta fechada"
msgstr ""

#: godot\scripts\game\story.gd:85
msgid "Da mãe de Ivone, de muitos anos atrás: “Filha, não abra a porta para ninguém depois que escurecer.”"
msgstr ""

#: godot\scripts\game\story.gd:86
msgid "Sem remetente. Dentro, só uma linha: “É a mamãe. Abre.”"
msgstr ""

#: godot\scripts\game\story.gd:87
msgid "Da prefeitura: aviso de que a casa estava abandonada havia dois anos."
msgstr ""

#: godot\scripts\game\story.gd:88
msgid "De Ivone para ninguém: “Tranquei Breu do lado de fora. Me perdoa. Eu precisava de silêncio.”"
msgstr ""

#: godot\scripts\game\story.gd:9
msgid "A antiga moradora, Dona Ivone, viveu ali sozinha por quarenta anos.\nUm dia, simplesmente sumiu."
msgstr ""

#: godot\scripts\game\story.gd:91
msgid "a última página do diário"
msgstr ""

#: godot\scripts\game\story.gd:91
msgid "“Sem ele, a casa ficou fria. Algo sobe a escada quando eu apago a luz.”"
msgstr ""

#: godot\scripts\game\story.gd:92
msgid "a última fita"
msgstr ""

#: godot\scripts\game\story.gd:92
msgid "Só água correndo. E, no fim, um miado longe, do lado de fora."
msgstr ""

#: godot\scripts\game\story.gd:93
msgid "a aliança de Ivone"
msgstr ""

#: godot\scripts\game\story.gd:93
msgid "A outra aliança, a do marido. Estava no ralo da banheira."
msgstr ""

#: godot\scripts\game\story.gd:94
msgid "o lenço de Ivone"
msgstr ""

#: godot\scripts\game\story.gd:94
msgid "O lenço que ela usa na foto. Tem pelos pretos de gato presos no tecido."
msgstr ""

#: godot\scripts\game\story.gd:95
msgid "um bilhete na porta"
msgstr ""

#: godot\scripts\game\story.gd:95
msgid "Com a letra tremida de Ivone: “Breu, se você voltar, eu deixo a janela aberta.”"
msgstr ""

#: godot\scripts\game\story.gd:99
msgid "uma página solta do diário"
msgstr ""

#: godot\scripts\game\story.gd:99
msgid "“Se alguém ler isto: o círculo não prende ninguém. Ele só lembra à casa quem mora nela.”"
msgstr ""

#: godot\scripts\threats\decay.gd:152
msgid "Uma torneira começou a pingar sozinha. Feche antes que alague."
msgstr ""

#: godot\scripts\threats\decay.gd:156
msgid "Um aparelho está esquentando sozinho. Puxe o fio."
msgstr ""

#: godot\scripts\threats\doll.gd:341
msgid "Ufa... que pesadelo."
msgstr ""

#: godot\scripts\threats\doll.gd:341
msgid "Hm? Tinha alguma coisa na cama...?"
msgstr ""

#: godot\scripts\threats\doll.gd:375
msgid "%s foi levado(a) pela Boneca"
msgstr ""

#: godot\scripts\threats\doll.gd:376
msgid "A Boneca andou pela casa sempre que ninguém olhava e apareceu na cama da pessoa."
msgstr ""

#: godot\scripts\threats\doll.gd:377
msgid "Encare-a (de perto ou num cômodo aceso) para congelá-la, pegue-a na boca e leve de volta ao baú do sótão. Carregá-la drena o Foco e você não pode bufar."
msgstr ""

#: godot\scripts\threats\doll.gd:42
msgid "a boneca"
msgstr ""

#: godot\scripts\threats\drowner.gd:149
msgid "Algo molhado saiu da água e está andando."
msgstr ""

#: godot\scripts\threats\drowner.gd:385
msgid "Patas secas no tapete: a trilha acabou."
msgstr ""

#: godot\scripts\threats\drowner.gd:416
msgid "A Afogadora ouviu o respingo e segue as suas pegadas molhadas. Corra até secarem ou seque as patas num tapete."
msgstr ""

#: godot\scripts\threats\drowner.gd:474
msgid "Ah! Tava tão gelado... mas passou."
msgstr ""

#: godot\scripts\threats\drowner.gd:474
msgid "Foi só um pesadelo... molhado."
msgstr ""

#: godot\scripts\threats\drowner.gd:474
msgid "{cat}... obrigada."
msgstr ""

#: godot\scripts\threats\drowner.gd:474
msgid "{cat}... valeu."
msgstr ""

#: godot\scripts\threats\drowner.gd:537
msgid "%s foi levado(a) pela Afogadora"
msgstr ""

#: godot\scripts\threats\drowner.gd:538
msgid "A Afogadora saiu da poça, atravessou a casa deixando pegadas molhadas e agarrou a pessoa com mãos geladas."
msgstr ""

#: godot\scripts\threats\drowner.gd:539
msgid "Feche a torneira que abre sozinha antes de a poça crescer. Se ela já saiu, faça barulho longe (derrube um copo) para atraí-la, ou bufe de perto: ela derrete ao andar."
msgstr ""

#: godot\scripts\threats\shadow.gd:1203
msgid "Ah! A luz..."
msgstr ""

#: godot\scripts\threats\shadow.gd:1203
msgid "Ufa... foi só um sonho..."
msgstr ""

#: godot\scripts\threats\shadow.gd:1203
msgid "O que... o que era aquilo?"
msgstr ""

#: godot\scripts\threats\shadow.gd:1428
msgid "no quarto de %s"
msgstr ""

#: godot\scripts\threats\shadow.gd:1428
msgid "no escuro"
msgstr ""

#: godot\scripts\threats\shadow.gd:1430
msgid "%s foi levado(a) pela Sombra"
msgstr ""

#: godot\scripts\threats\shadow.gd:1431
msgid "A Sombra atravessou a casa e chegou %s. Ela só se aproxima onde não há luz."
msgstr ""

#: godot\scripts\threats\shadow.gd:1432
msgid "Olhe para ela: ela foge e se esconde. Acenda a luz do cômodo onde ela vai sair e ela some ao pisar na luz. Não encare o esconderijo: ela vem atrás de você."
msgstr ""

#: godot\scripts\threats\shadow.gd:285
msgid "Hmm... quem tá aí...?"
msgstr ""

#: godot\scripts\threats\shadow.gd:285
msgid "...{cat}? É você?"
msgstr ""

#: godot\scripts\threats\shadow.gd:285
msgid "Que frio..."
msgstr ""

#: godot\scripts\threats\shadow.gd:687
msgid "A Sombra [b]foge do seu olhar[/b]... mas não encare onde ela se esconde."
msgstr ""

#: godot\scripts\threats\shadow.gd:952
msgid "A Sombra [b]não se esconde mais[/b]. Só a luz a expulsa: acenda o cômodo onde ela está ou leve-a até um cômodo aceso."
msgstr ""

#: godot\scripts\threats\thing.gd:304
msgid "O que... a casa tá tremendo!"
msgstr ""

#: godot\scripts\threats\thing.gd:305
msgid "Algo acordou no porão. Leve tudo ao círculo e complete o ritual."
msgstr ""

#: godot\scripts\threats\thing.gd:347
msgid "A casa não aguentou"
msgstr ""

#: godot\scripts\threats\thing.gd:348
msgid "O medo das assombrações, com a Coisa acordada no porão, chegou ao limite antes de o ritual terminar."
msgstr ""

#: godot\scripts\threats\thing.gd:349
msgid "Leve os cinco objetos ao círculo e segure o ritual. A Coisa não ataca: ela deixa a casa mais difícil, então não demore."
msgstr ""

#: godot\scripts\threats\threat.gd:249
msgid "%s foi levado(a)"
msgstr ""

#: godot\scripts\threats\threat.gd:250
msgid "%s chegou até %s."
msgstr ""

#: godot\scripts\threats\threat.gd:251
msgid "Fique de olho nos sinais sonoros e resolva a ameaça antes que ela chegue."
msgstr ""

#: godot\scripts\threats\visitor.gd:320
msgid "Já vai, mãe... só um segundo..."
msgstr ""

#: godot\scripts\threats\visitor.gd:377
msgid "%s abriu a porta"
msgstr ""

#: godot\scripts\threats\visitor.gd:378
msgid "O Visitante imitou uma voz conhecida, %s foi atender e deixou entrar o que estava lá fora."
msgstr ""

#: godot\scripts\threats\visitor.gd:379
msgid "Saia de casa e bufe para ele de perto. Se ele perseguir, corra para dentro de casa."
msgstr ""

#: godot\scripts\threats\visitor.gd:390
msgid "Ele vem atrás de você! Corra para dentro de casa!"
msgstr ""

#: godot\scripts\threats\visitor.gd:398
msgid "...Foi embora? Mãe?"
msgstr ""

#: godot\scripts\threats\visitor.gd:398
msgid "Ninguém... não tem ninguém aí."
msgstr ""

#: godot\scripts\threats\visitor.gd:398
msgid "{cat}, você bufou pra quem?"
msgstr ""

#: godot\scripts\threats\visitor.gd:47
msgid "a porta da frente"
msgstr ""

#: godot\scripts\threats\visitor.gd:48
msgid "a janela da sala"
msgstr ""

#: godot\scripts\threats\visitor.gd:49
msgid "a janela da cozinha"
msgstr ""

#: godot\scripts\threats\visitor.gd:86
msgid "“Clara... é a mamãe... abre %s...”"
msgstr ""

#: godot\scripts\threats\visitor.gd:86
msgid "a porta"
msgstr ""

#: godot\scripts\threats\visitor.gd:86
msgid "a janela"
msgstr ""

#: godot\scripts\threats\visitor.gd:99
msgid "Mãe? A essa hora?"
msgstr ""

#: godot\scripts\threats\visitor.gd:99
msgid "Quem é...? Mãe?"
msgstr ""

#: godot\scripts\threats\visitor.gd:99
msgid "Já vai! Calma..."
msgstr ""

#: godot\scripts\threats\whisperer.gd:242
msgid "Ele pulou para %s!"
msgstr ""

#: godot\scripts\threats\whisperer.gd:273
msgid "Nem todo som é de verdade. O Sussurrador imita a casa."
msgstr ""

#: godot\scripts\threats\whisperer.gd:329
msgid "WHISPER unplugged on %s: chance %.2f"
msgstr ""

#: godot\scripts\threats\whisperer.gd:554
msgid "O que eu tô fazendo aqui...?"
msgstr ""

#: godot\scripts\threats\whisperer.gd:554
msgid "Ai... eu tava sonhando com uma voz..."
msgstr ""

#: godot\scripts\threats\whisperer.gd:554
msgid "{cat}? Por que a TV... deixa pra lá."
