msgstr "Bring the toy mouse to Clara"

#: godot\scripts\game\interactions.gd:429
msgid "Levar o novelo para Clara"
msgstr "Bring the yarn ball to Clara"

#: godot\scripts\game\interactions.gd:433
msgid "Miar para a Clara encher a água"
msgstr "Meow for Clara to refill the water"

#: godot\scripts\game\interactions.gd:437
msgid "Cochilar no sol"
msgstr "Nap in the sun"

#: godot\scripts\game\interactions.gd:443
msgid "Dar a chave para Clara"
msgstr "Give the key to Clara"

#: godot\scripts\game\interactions.gd:452
msgid "Arranhar a porta do banheiro"
msgstr "Scratch the bathroom door"

#: godot\scripts\game\interactions.gd:457
