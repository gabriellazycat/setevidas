msgstr "Cat's name"

#: godot\scripts\ui\ui.gd:1623
msgid "Como Clara chama você"
msgstr "What Clara calls you"

#: godot\scripts\ui\ui.gd:1624
msgid "Velocidade das noites"
msgstr "Night speed"

#: godot\scripts\ui\ui.gd:1624
msgid "Valores menores deixam as assombrações mais lentas"
msgstr "Lower values make the haunts slower"

#: godot\scripts\ui\ui.gd:1625
msgid "Esgueirar alterna"
msgstr "Toggle sneak"

#: godot\scripts\ui\ui.gd:1625
msgid "Desligado: segure o botão"
msgstr "Off: hold the button"

